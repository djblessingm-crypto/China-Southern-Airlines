# CSN Virtual — environment template.
# Copy to ".env" and fill in real values. NEVER commit the real .env.

# Long, random session secret (32+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Discord OAuth2 application credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Staff / admin API key. Sent by the staff and admin frontends as the
# "x-csn-staff-key" header. Use a long random value.
CSN_STAFF_API_KEY=

# Optional: Discord channel webhook for booking notifications.
DISCORD_WEBHOOK_URL=

# Optional
PORT=3000
NODE_ENV=development
